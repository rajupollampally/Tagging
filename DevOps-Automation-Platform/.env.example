"""Environment variables template"""

# Application
APP_NAME=Intelligent Deployment Governance Platform
APP_VERSION=1.0.0
DEBUG=False
LOG_LEVEL=INFO
ENVIRONMENT=development

# Database
DATABASE_URL=postgresql://devops:devops@postgres:5432/devops_platform
DATABASE_ECHO=False

# Redis
REDIS_URL=redis://redis:6379/0
REDIS_TTL=3600

# Kafka
KAFKA_BROKERS=kafka:9092
KAFKA_TOPIC_DEPLOYMENTS=deployments
KAFKA_TOPIC_APPROVALS=approvals
KAFKA_TOPIC_BUDGETS=budgets

# JWT
JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# OpenAI
OPENAI_API_KEY=sk-
OPENAI_MODEL=gpt-4

# Slack
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/
SLACK_BOT_TOKEN=xoxb-

# Microsoft Teams
TEAMS_WEBHOOK_URL=https://outlook.webhook.office.com/

# Jira
JIRA_URL=https://jira.company.com
JIRA_USERNAME=bot@company.com
JIRA_API_TOKEN=

# ServiceNow
SERVICENOW_URL=https://dev12345.service-now.com
SERVICENOW_USERNAME=bot
SERVICENOW_PASSWORD=

# Jenkins
JENKINS_URL=https://jenkins.company.com
JENKINS_USERNAME=bot
JENKINS_API_TOKEN=

# GitHub
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=

# Azure DevOps
AZURE_DEVOPS_URL=https://dev.azure.com/organization
AZURE_DEVOPS_PAT=

# CORS
CORS_ORIGINS=["*"]

# Observability
ENABLE_TRACING=True
JAEGER_HOST=jaeger
JAEGER_PORT=6831
ENABLE_METRICS=True

# Budget Thresholds
BUDGET_ALERT_THRESHOLD=1000.0
BUDGET_CRITICAL_THRESHOLD=5000.0
